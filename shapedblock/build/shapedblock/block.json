{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "create-block/shapedblock",
  "version": "0.1.0",
  "title": "Shaped Text",
  "category": "widgets",
  "icon": "text",
  "description": "A Block of Text",
  "keywords": [
    "text",
    "paragraph",
    "box"
  ],
  "supports": {
    "html": false,
    "color": {
      "background": true,
      "text": true,
      "gradients": true,
      "link": true
    },
    "spacing": {
      "padding": true
    }
  },
  "styles": [
    {
      "name": "squared",
      "label": "Squared",
      "isDefault": true
    },
    {
      "name": "rounded",
      "label": "Rounded"
    }
  ],
  "example": {
    "attributes": {
      "text": "This is some Text!",
      "shadow": true
    }
  },
  "textdomain": "shaped-text",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "attributes": {
    "text": {
      "type": "string",
      "source": "html",
      "selector": "h4"
    },
    "alignment": {
      "type": "string",
      "default": "left"
    },
    "shadow": {
      "type": "boolean",
      "default": false
    },
    "shadowOpacity": {
      "type": "number",
      "default": 30
    },
    "textColor": {
      "type": "string",
      "default": "#000"
    },
    "style": {
      "type": "object",
      "default": {
        "color": {
          "background": "#fff"
        },
        "spacing": {
          "padding": {
            "top": "50px",
            "right": "50px",
            "bottom": "50px",
            "left": "50px"
          }
        }
      }
    }
  },
  "viewScript": "file:./view.js"
}